# QuickTix Frontend Environment Variables Template
# Copy this file to '.env' and update the values as needed.

# For Local Development (Uses Vite dev server proxy to localhost:8080):
VITE_API_BASE_URL=/api

# For Production Deployment (e.g. Vercel, Netlify, Render):
# Set this to your live backend base URL:
# VITE_API_BASE_URL=https://your-quicktix-backend.onrender.com/api
