# Server Environment Variables (.env)
# -------------------------------------------------------------
# Database Connection (Neon Tech / Supabase / Railway / Aiven / Local Postgres)
DB_URL=jdbc:postgresql://<host>:5432/<database_name>?sslmode=require
DB_USERNAME=<database_username>
DB_PASSWORD=<database_password>

# JWT Secret (Min 256-bit / 32+ characters hex or secure string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Optional Server Port (Defaults to 8080 or assigned by cloud host)
PORT=8080

# Spring Active Profile
SPRING_PROFILES_ACTIVE=dev
